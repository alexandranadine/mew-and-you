# Cloudflare Pages custom headers for cache-friendly static assets.
# https://developers.cloudflare.com/pages/configuration/headers/

# Vite emits content-hashed filenames under /assets — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public images (no content hash); moderate cache with revalidation room.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.svg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# HTML / SPA shell should always revalidate so deploys take effect promptly.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
