# See ../DEPLOYMENT.md for staging/production build and deploy steps.
#
# Canonical origin for sitemap, robots.txt, and absolute social URLs.
# No trailing slash. Set this to the public frontend URL in production.
VITE_SITE_URL=http://localhost:5173

# Cloudflare Pages (staging): add VITE_SITE_URL under Settings → Environment
# variables for Production and Preview so the build bakes in the public origin.
# When the API is deployed on Render, set API_ORIGIN (runtime) in Cloudflare Pages
# → Settings → Environment variables (Production and Preview):
#   API_ORIGIN=https://YOUR-RENDER-URL.onrender.com
# No trailing slash. Example service name from render.yaml: mew-and-you-api-staging.
