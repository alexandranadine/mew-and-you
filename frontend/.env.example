# See ../DEPLOYMENT.md for staging/production build and deploy steps.
#
# Canonical origin for sitemap, robots.txt, and absolute social URLs.
# No trailing slash. Local default; production uses `.env.production`.
# Schemeless values (e.g. mewandyou.com) are normalized to https:// at build time.
VITE_SITE_URL=http://localhost:5173

# --- Cloudflare Pages (Production / Preview) ---
# Build-time (Settings → Environment variables → Build), optional override:
#   Production:  VITE_SITE_URL=https://mewandyou.com
#   Preview:     VITE_SITE_URL=https://mew-and-you.pages.dev
# Prefer the full https:// origin. Bare hostnames still work via normalization.
#
# Runtime (Settings → Environment variables → Production and Preview):
#   API_ORIGIN=https://YOUR-SERVICE.onrender.com
# No trailing slash. Do not commit the real Render hostname — set it only in
# the Pages dashboard. The Pages Function at functions/api/[[path]].ts reads
# API_ORIGIN and returns 503 until it is set.
#
# --- Render API ---
# Set CORS_ORIGIN on the web service to the same public SPA origin, e.g.:
#   CORS_ORIGIN=https://mew-and-you.pages.dev
# (render.yaml leaves CORS_ORIGIN as sync: false so the value stays in the dashboard.)
