# See ../DEPLOYMENT.md for staging/production values and routing requirements.
#
# Which data source powers /api/cats: "mock" (default, no API key needed) or
# "rescuegroups" (requires RESCUEGROUPS_API_KEY below).
DATA_PROVIDER=mock

# RescueGroups.org API key (server-side only — never expose this to the frontend).
# Only required when DATA_PROVIDER=rescuegroups.
# Request a free public key at https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=your_rescuegroups_api_key_here

# Base URL for the RescueGroups v5 API. Only change this if RescueGroups gives you
# a different environment (e.g. a test environment URL).
RESCUEGROUPS_BASE_URL=https://api.rescuegroups.org/v5

# Port this Express server listens on.
PORT=3001

# development | production | test — usually set by the hosting platform, not
# needed locally. In production, CORS_ORIGIN becomes required (no safe default).
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (CORS). Required in
# production; defaults to http://localhost:5173 in development if unset.
CORS_ORIGIN=http://localhost:5173

# Set to "true" only when deployed behind a trusted reverse proxy/load balancer
# (so rate limiting sees the real client IP via X-Forwarded-For). Leave unset
# or "false" otherwise — trusting this header without an actual proxy in front
# lets clients spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# Rate limiting for /api/cats (per IP). Defaults: 100 requests / 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
